{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "rootDir": ".",
    "outDir": "./dist",

    "strict": true,
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },

  "include": [
    "src/**/*.ts",
    "prisma.config.ts",
    "seed.ts",
    "test-*.ts",
    "negative-test.ts"
  ],

  "exclude": [
    "node_modules",
    "dist"
  ]
}